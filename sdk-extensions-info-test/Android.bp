package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_test_host {
    name: "sdk-extensions-info-test",
    edition: "2021",
    clippy_lints: "android",
    lints: "android",
    crate_root: "test.rs",
    srcs: [
        "test.rs",
        "testdata/*.xml",
        ":sdk-extensions-info",
    ],
    rustlibs: [
        "libanyhow",
        "libitertools",
        "libxml_rust",
    ],
    test_suites: ["general-tests"],
    use_expansive_default_srcs: false,
}
